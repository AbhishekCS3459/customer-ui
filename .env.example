# Copy to .env.local. NEXT_PUBLIC_ values are baked in at build time.

# Leave empty so the browser calls /api on this Next app, which proxies to the Go API
# (no CORS needed). Set a full origin only to call a backend directly; its
# CORS_ALLOWED_ORIGINS must then include this UI's origin.
NEXT_PUBLIC_API_URL=
# BACKEND_URL comes from .env.development (next dev) and .env.production (next build).
# Set it here only to override both, e.g. to point local dev at Azure.

# Map tiles for the nearby stores map (Leaflet URL template and its attribution
# HTML). Empty uses OpenStreetMap's tiles, which are for development and light
# use only; set a hosted provider for production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Send X-Debug: 1 so exact quantities show. Only works when the backend runs
# with DEBUG_MARKETPLACE=true, and never in production.
NEXT_PUBLIC_MARKETPLACE_DEBUG=false
